# AutoPilot-ML local configuration.
# Copy this file to `.env` and adjust values. No API keys are required:
# the whole system runs locally with zero paid-API usage.

# Logging level: DEBUG, INFO, WARNING, ERROR
AUTOPILOT_LOG_LEVEL=INFO

# MLflow tracking backend. Leave empty to use the local default:
#   sqlite:///<project>/mlruns/mlflow.db  (artifacts in <project>/mlruns/artifacts)
AUTOPILOT_MLFLOW_TRACKING_URI=
AUTOPILOT_MLFLOW_EXPERIMENT_NAME=autopilot-ml-baseline

# Experiment defaults shown in the UI
AUTOPILOT_DEFAULT_TIME_BUDGET=60
AUTOPILOT_DEFAULT_SEED=42
AUTOPILOT_DEFAULT_TEST_SIZE=0.2

# CPU cores used by FLAML (-1 = all available cores)
AUTOPILOT_N_JOBS=-1

# Maximum CSV upload size in the UI (MB)
AUTOPILOT_MAX_UPLOAD_MB=200
